REACT_APP_API_BASE_URL=http://127.0.0.1:5001

# Firebase Configuration (Get these from Firebase Console: Project Settings)
REACT_APP_FIREBASE_API_KEY=YOUR_API_KEY
REACT_APP_FIREBASE_AUTH_DOMAIN=solidevbooks.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=solidevbooks
REACT_APP_FIREBASE_STORAGE_BUCKET=solidevbooks.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
REACT_APP_FIREBASE_APP_ID=YOUR_APP_ID
REACT_APP_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# ── Dev-only RBAC autofill credentials ───────────────────────────────────────
# Set these to the emails/passwords of your local test accounts.
# These are ONLY rendered in the login page when NODE_ENV=development.
REACT_APP_DEV_ADMIN_EMAIL=admin@dev.local
REACT_APP_DEV_ADMIN_PASSWORD=Admin@1234

REACT_APP_DEV_MANAGER_EMAIL=manager@dev.local
REACT_APP_DEV_MANAGER_PASSWORD=Manager@1234

REACT_APP_DEV_SALES_EMAIL=sales@dev.local
REACT_APP_DEV_SALES_PASSWORD=Sales@1234

REACT_APP_DEV_ACCOUNTANT_EMAIL=accountant@dev.local
REACT_APP_DEV_ACCOUNTANT_PASSWORD=Accountant@1234

REACT_APP_DEV_PURCHASER_EMAIL=purchaser@dev.local
REACT_APP_DEV_PURCHASER_PASSWORD=Purchaser@1234
